# TASK-15 ADK image. All application configuration is mounted at build time
# from generated non-secret artifacts; no default model/tools/template.
# Build context: repository root. --build-context model-config=<generated dir>
ARG GO_IMAGE=golang:1.27@sha256:820153096fda4de6ac1b7194d12e416b7dd8f4e9a33d17e0345b111b945162d8
ARG PYTHON_IMAGE=python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2
FROM ${GO_IMAGE} AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY packages ./packages
COPY services/runtime ./services/runtime
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/agent-runtime ./services/runtime/cmd/supervisor \
 && CGO_ENABLED=0 go build -trimpath -o /out/canonical-digest ./packages/canonical/cmd/canonical-digest \
 && CGO_ENABLED=1 go build -trimpath -buildmode=c-shared -o /out/agentarium-isolation.so ./services/runtime/cmd/isolation-library

ARG MODEL_TOOLS_DIGEST
COPY --from=model-config /model-tools.json /verified/model-tools.json
RUN test -n "$MODEL_TOOLS_DIGEST" \
 && test "$(/out/canonical-digest < /verified/model-tools.json)" = "$MODEL_TOOLS_DIGEST"

FROM ${PYTHON_IMAGE} AS python-build
WORKDIR /src
COPY services/runtime/python/pyproject.toml services/runtime/python/uv.lock ./
# uv is a build tool only, not installed in the final image.
RUN pip install --no-cache-dir uv==0.9.14
COPY services/runtime/python/src ./src
ENV UV_PROJECT_ENVIRONMENT=/app/venv UV_PYTHON_DOWNLOADS=never
RUN uv sync --frozen --no-dev --no-editable --python /usr/local/bin/python3.12

FROM ${PYTHON_IMAGE}
COPY --from=go-build /out/agent-runtime /app/bin/agent-runtime
COPY --from=go-build /out/agentarium-isolation.so /app/lib/agentarium-isolation.so
COPY --from=python-build /app/venv /app/venv
COPY --from=model-config /runtime.json /app/model/runtime.json
COPY --from=go-build /verified/model-tools.json /app/model/model-tools.json
ARG MODEL_TOOLS_DIGEST
LABEL io.agentarium.model-tools-digest=$MODEL_TOOLS_DIGEST
ENV AGENTARIUM_RUNTIME_MODE=adk
USER 10001:10001
ENTRYPOINT ["/app/bin/agent-runtime"]
